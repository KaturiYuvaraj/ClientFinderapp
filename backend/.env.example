# Database Configuration
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/client_finder
# Fallback to sqlite if MySQL is unreachable during development
DATABASE_FALLBACK_SQLITE=true

# Authentication
JWT_SECRET=super_secret_jwt_key_change_in_production_min_32_chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Configuration (gemini, openai, rule_based, mock)
AI_PROVIDER=rule_based
AI_API_KEY=your_ai_api_key
AI_MODEL=gemini-1.5-flash

# Business Data Provider (overpass, google_places, mock)
BUSINESS_API_PROVIDER=mock
BUSINESS_API_KEY=your_business_api_key

# Security & CORS
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_PER_MINUTE=60
